 import { prisma } from "@/lib/prisma";
 import { NextResponse } from "next/server";
 
+type SearchResult = {
+  id: string;
+  type: "product" | "collection" | "movie" | "actor";
+  title: string;
+  subtitle: string;
+  href: string;
+  image: string | null;
