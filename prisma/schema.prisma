generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  price       Int
  image       String
  buyLink     String
  collection  String
  actorName   String?
  movie       String?
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())

  actors      ActorProduct[]
  outfits     OutfitProduct[]
}

model Request {
  id        String   @id @default(cuid())
  content   String
  email     String?
  createdAt DateTime @default(now())
}

model HeroItem {
  id        String   @id @default(cuid())
  title     String
  movieName String
  image     String
  ctaLink   String
  createdAt DateTime @default(now())
}
model Collection {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  image       String?
  description String?
  showInHome  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model Actor {
  id        String         @id @default(cuid())
  name      String         @unique
  slug      String         @unique
  image     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @default(now()) @updatedAt

  products  ActorProduct[]
}

model ActorProduct {
  actorId   String
  productId String
  createdAt DateTime @default(now())

  actor   Actor   @relation(fields: [actorId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([actorId, productId])
  @@index([productId])
}

model OutfitIdea {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  image       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  products    OutfitProduct[]

  @@index([updatedAt])
}

model OutfitProduct {
  outfitId  String
  productId String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  outfit  OutfitIdea @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([outfitId, productId])
  @@index([productId])
  @@index([outfitId, order])
}
