generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  price       Int
  image       String
  buyLink     String
  collection  String
  actorName   String?
  movie       String?
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())

}

model Request {
  id        String   @id @default(cuid())
  content   String
  email     String?
  createdAt DateTime @default(now())
}

model HeroItem {
  id        String   @id @default(cuid())
  title     String
  movieName String
  image     String
  ctaLink   String
  createdAt DateTime @default(now())
}

model Collection {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  image       String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

