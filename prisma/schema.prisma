generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
model ActorLook {
  id        String    @id @default(cuid())
  slug      String    @unique
  actorName String
  movie     String
  image     String
  createdAt DateTime  @default(now())

  products  Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  price       Int
  image       String
  buyLink     String
  collection  String
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  actorLookId String?
  actorLook   ActorLook? @relation(fields: [actorLookId], references: [id])
}

model Request {
  id        String   @id @default(cuid())
  content   String
  email     String?
  createdAt DateTime @default(now())
}
