generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  price       Int
  image       String
  buyLink     String
  collection  String
  actorName   String?
  movie       String?
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())

}

model Request {
  id        String   @id @default(cuid())
  content   String
  email     String?
  createdAt DateTime @default(now())
}
